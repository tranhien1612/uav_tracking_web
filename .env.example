# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# RTSP Camera Stream (IP Camera / Drone Video Transmitter)
# Vi du: rtsp://192.168.1.100:554/live hoac rtsp://admin:password@192.168.1.50:554/stream1
RTSP_URL=rtsp://192.168.144.108
RTSP_TRANSPORT=tcp
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAMERA_FPS=30
USE_SIMULATOR_CAMERA=False

# MAVLink ArduPilot Connection
# For ArduPilot SITL: udp:127.0.0.1:14550
# For Telemetry Radio: COM3 (Windows) hoac /dev/ttyUSB0 (Linux)
MAVLINK_CONNECTION=udp:127.0.0.1:14550
MAVLINK_BAUD=57600
MOCK_MAVLINK=True

# Visual Servoing Gains
DEADBAND_X=0.08
DEADBAND_Y=0.08
KP_YAW=0.6
KP_SWAY=0.8
KP_CLIMB=0.7
MAX_VELOCITY_XY=1.2
MAX_VELOCITY_Z=0.8
MAX_YAW_RATE=0.6
DWELL_TIME_SEC=2.5
